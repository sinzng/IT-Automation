---
- name: change_password_play
  hosts: all
  strategy: free
  gather_facts: false
  tasks: 
    - name: vars 호출
      include_vars: ../vars/passwd_vars.yml

    - name: 날짜 연+월
      set_fact:
        fap_today: "{{ lookup('ansible.builtin.pipe','date +%Y%m')}}" # 연 월 합친 변수 생성
      delegate_to: localhost

    - name: 날짜 출력 메시지
      debug:
        msg:
        - "날짜: {{ fap_today }}"
        - "짝수 달에는 root 계정의 패스워드를 변경 합니다."
        - "홀수 달에는 sysmng 계정의 패스워드를 변경하고, FAP 서버의 암호를 업데이트 합니다."

    - name: 실행 계정 추출
      fap.common.get_credential:
        credential_name: "{{ fap_today }}"
      register: user_info
      delegate_to: localhost

    - name: 실행 계정 패스워드 패턴 추출
      set_fact:
        month_user: "{{ user_info.data.username }}"
        month_pass: "{{ user_info.data.password | regex_replace('\\${3}', '%03d' % (fap.host_ip.split('.')[2] | int)) }}"

    - name: 변경 계정 출력
      debug:
        msg:
          - "{{ month_user }}"
          - "{{ month_pass }}"

    - name: 접속 확인
      raw: uname
      register: uname_result
      ignore_errors: yes
      when: ansible_port != 5985

    - name: 접속 결과 출력
      fail:
        msg: "접속 불가합니다. 통신 확인"
      when: 
        - uname_result.rc != 0  # 명령이 정상적으로 실행되지 않은 경우에만 중단
        - ansible_port != 5985

    - name: 접속 결과 출력 정상
      debug:
        var: uname_result.stdout

    - name: python tasks
      include_tasks: ../tasks/python_passwd.yml
      when: ansible_port != 5985

    - name: Windows tasks
      include_tasks: ../tasks/windows_passwd.yml
      when: ansible_port == 5985

    - name: DB Save
      include_tasks: ../tasks/py_passwd_dbsave.yml

    - name: 패스워드 변경 실패
      fail:
        msg: "패스워드 변경확인 필요로 작업 중지"
      when: "'패스워드 변경이 완료되었습니다' not in password_value.stdout"

    - name: "FAP root password 변경 "
      fap.common.change_host_credential:
        host_ip: "{{ fap.host_ip }}"
        become_password: "{{ month_pass }}"
      delegate_to: localhost
      when: month_user == 'root'

    - name: "FAP sysmng password 변경 "
      fap.common.change_host_credential:
        host_ip: "{{ fap.host_ip }}"
        password: "{{ month_pass }}"
      delegate_to: localhost
      when: month_user == 'sysmng'
